{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sivere.local/schemas/benchmark-node-qualification-score-v1.json",
  "title": "BenchmarkNode high-assurance qualification score",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "suite_id", "evidence_digest", "evidence_envelope_closed",
    "held_out_applications_passed", "promotion_eligible", "score",
    "category_scores", "reason_codes"
  ],
  "properties": {
    "schema_version": {"const": "security-benchmark-score/v1"},
    "suite_id": {"const": "sivere-benchmark-node-v1"},
    "evidence_digest": {"$ref": "#/$defs/digest"},
    "evidence_envelope_closed": {"type": "boolean"},
    "held_out_applications_passed": {"type": "boolean"},
    "promotion_eligible": {"type": "boolean"},
    "score": {"$ref": "#/$defs/score"},
    "category_scores": {
      "type": "array",
      "minItems": 40,
      "maxItems": 40,
      "items": {"$ref": "#/$defs/category_score"}
    },
    "reason_codes": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "score": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status", "tp", "fp", "fn", "tn", "unknown_controls_passed",
        "unsupported_controls_passed", "evidence_grade_mismatches",
        "reason_code_mismatches", "unresolved", "unexpected_observations", "passed"
      ],
      "properties": {
        "status": {"enum": ["INCOMPLETE", "COMPLETE"]},
        "tp": {"type": "integer", "minimum": 0, "maximum": 40},
        "fp": {"type": "integer", "minimum": 0},
        "fn": {"type": "integer", "minimum": 0, "maximum": 40},
        "tn": {"type": "integer", "minimum": 0, "maximum": 40},
        "unknown_controls_passed": {"type": "integer", "minimum": 0, "maximum": 40},
        "unsupported_controls_passed": {"type": "integer", "minimum": 0, "maximum": 40},
        "evidence_grade_mismatches": {"type": "integer", "minimum": 0},
        "reason_code_mismatches": {"type": "integer", "minimum": 0},
        "unresolved": {"type": "integer", "minimum": 0, "maximum": 160},
        "unexpected_observations": {"type": "integer", "minimum": 0},
        "passed": {"type": "boolean"}
      }
    },
    "category_score": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "category", "mapping", "required_evidence_grade", "tp", "fp", "fn", "tn",
        "evidence_grade_mismatches", "reason_code_mismatches", "unresolved", "passed"
      ],
      "properties": {
        "category": {"type": "string", "minLength": 1},
        "mapping": {"enum": ["DIRECT", "ADAPTED", "CONTROLLER"]},
        "required_evidence_grade": {"type": "string", "minLength": 1},
        "tp": {"type": "integer", "minimum": 0, "maximum": 1},
        "fp": {"type": "integer", "minimum": 0},
        "fn": {"type": "integer", "minimum": 0, "maximum": 1},
        "tn": {"type": "integer", "minimum": 0, "maximum": 1},
        "evidence_grade_mismatches": {"type": "integer", "minimum": 0},
        "reason_code_mismatches": {"type": "integer", "minimum": 0},
        "unresolved": {"type": "integer", "minimum": 0, "maximum": 4},
        "passed": {"type": "boolean"}
      }
    }
  }
}
